    "Enabled": true,
    "CredentialsPath": "wanees-notification.json",
    "CredentialsJson": ""
  },
  "Storage": {
    // Uploaded driver documents. Relative to the content root, and deliberately
    // outside wwwroot: an identity document is served only through the
